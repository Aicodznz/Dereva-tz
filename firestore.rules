rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Primitives & Global Helpers
    // -------------------------------------------------------------------------

    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "aicodtznation@gmail.com"
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // -------------------------------------------------------------------------
    // Match Blocks
    // -------------------------------------------------------------------------

    // 1. Config (Public Read for platform settings)
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 1.5 Admins (Self-healing list)
    match /admins/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Vendors (Public Read)
    match /vendors/{id} { 
      allow read: if true; 
      allow write: if isSignedIn(); 
    }

    // 3. Products (Public Read)
    match /products/{id} { 
      allow read: if true; 
      allow write: if isSignedIn(); 
    }

    // 4. Reviews & Replies (Public Read - Fixed Permission)
    match /reviews/{id} { 
      allow read: if true; 
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /review_replies/{id} { 
      allow read: if true; 
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 5. Banners (Public Read)
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }

    // 6. Orders (Restricted to participants)
    match /orders/{orderId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // 7. Users
    match /users/{userId} {
      allow get, list, create, update: if isSignedIn();
    }

    // 8. Notifications
    match /notifications/{id} {
      allow read, write: if isSignedIn();
    }

    // 9. Messaging
    match /messages/{id} {
      allow read, write: if isSignedIn();
    }

    // 10. Default Deny for everything else
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

