rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Primitives & Global Helpers
    // -------------------------------------------------------------------------

    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn(); } // Simplified for now as requested by user's initial rules
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "aicodtznation@gmail.com"
      );
    }

    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // -------------------------------------------------------------------------
    // Match Blocks
    // -------------------------------------------------------------------------

    // 1. Config (Public Read for platform settings)
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 1.5 Admins
    match /admins/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Vendors (Public Read)
    match /vendors/{id} { 
      allow read: if true; 
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == existing().ownerUid || isAdmin());
      allow delete: if isAdmin();
    }

    // 3. Products (Public Read)
    match /products/{id} { 
      allow read: if true; 
      allow write: if isSignedIn(); 
    }

    // 3.5 Branches (Public Read)
    match /branches/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 3.6 Hotel Bookings & Seasons (New)
    match /hotel_bookings/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 4. Reviews & Replies (Public Read)
    match /reviews/{id} { 
      allow read: if true; 
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /review_replies/{id} { 
      allow read: if true; 
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 5. Banners (Public Read)
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }

    // 6. Orders (Restricted to participants)
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.vendorOwnerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // 7. Users
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 8. Notifications
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn();
    }

    // 9. Messaging
    match /messages/{id} {
      allow read: if isSignedIn() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if isSignedIn();
    }

    // 10. Default Deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

