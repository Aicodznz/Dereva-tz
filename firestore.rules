rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // PHASE 1: REUSABLE HELPERS
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // PHASE 2: COLLECTION RULES
    // -------------------------------------------------------------------------

    // 1. USERS COLLECTION
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'uid', 'createdAt'])
      );
    }

    // 2. VENDORS COLLECTION
    match /vendors/{vendorId} {
      allow read: if true; // Public access to browse stores
      allow create: if isSignedIn(); // Any signed-in user can become a vendor
      allow update: if isOwner(existing().ownerUid) || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow delete: if isOwner(existing().ownerUid);

      match /sections/{sectionId} {
        allow read: if true;
        allow write: if isOwner(get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerUid);
      }
    }

    // 3. STAFF COLLECTION
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow create: if isOwner(incoming().vendorOwnerUid);
      allow update: if isOwner(existing().vendorOwnerUid) || isOwner(existing().uid) || (isSignedIn() && incoming().uid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['uid']));
      allow delete: if isOwner(existing().vendorOwnerUid);
    }

    // 4. RIDES COLLECTION
    match /rides/{rideId} {
      allow read: if isSignedIn() && (
        isOwner(existing().customerId) || 
        isOwner(existing().driverId) || 
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // 5. ORDERS COLLECTION
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        isOwner(existing().customerId) || 
        isOwner(get(/databases/$(database)/documents/vendors/$(existing().vendorId)).data.ownerUid)
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // 6. PRODUCTS COLLECTION
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(get(/databases/$(database)/documents/vendors/$(existing().vendorId)).data.ownerUid);
    }

    // 7. DRIVERS COLLECTION
    match /drivers/{driverId} {
      allow read: if true;
      allow write: if isOwner(driverId);
    }

    // 8. NOTIFICATIONS
    match /notifications/{notifId} {
      allow read: if isOwner(existing().userId);
      allow create: if isSignedIn();
    }

    // 9. MESSAGES
    match /messages/{msgId} {
      allow read: if isSignedIn() && request.auth.uid in existing().participants;
      allow create: if isSignedIn() && request.auth.uid in incoming().participants;
      allow update: if isSignedIn() && request.auth.uid in existing().participants;
    }

    // 10. DRIVER POIS / LOCAL SERVICES
    match /pois/{poiId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        (resource != null && existing().submittedBy == request.auth.uid) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
