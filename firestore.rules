rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // Phase 3: Primitives & Global Helpers
    // -------------------------------------------------------------------------

    function isSignedIn() { return request.auth != null; }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "aicodtznation@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Phase 4: Match Blocks
    // -------------------------------------------------------------------------

    // Users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isOwner(userId) || isAdmin()
      );
    }

    // Vendors
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        (isOwner(existing().ownerUid)) || isAdmin()
      );
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && (
        get(/databases/$(database)/documents/vendors/$(incoming().vendorId)).data.ownerUid == request.auth.uid ||
        isAdmin()
      );
    }

    // Orders
    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.vendorOwnerUid == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // Notifications
    match /notifications/{id} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Reviews
    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Review Replies
    match /review_replies/{id} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Parcels
    match /parcels/{id} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // Ride Hailing
    match /rides/{id} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // Drivers/Riders status
    match /drivers/{id} { allow read, write: if isSignedIn(); }
    match /riders/{id} { allow read, write: if isSignedIn(); }

    // Messages
    match /messages/{id} {
      allow read: if isSignedIn() && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
      allow create: if isSignedIn() && incoming().participants.hasAny([request.auth.uid]);
    }

    // Banners
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons
    match /coupons/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && incoming().vendorOwnerUid == request.auth.uid);
    }

    // Payouts
    match /payouts/{id} {
      allow read: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Tables
    match /tables/{id} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && incoming().vendorOwnerUid == request.auth.uid);
    }

    // Staff
    match /staff/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && incoming().vendorOwnerUid == request.auth.uid);
    }
  }
}
