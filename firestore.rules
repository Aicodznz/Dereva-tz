rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Phase 3: Primitives & Global Helpers
    // -------------------------------------------------------------------------
    
    function isSignedIn() { return request.auth != null; }
    
    function isVerified() {
      // Relaxed for development, but ideally mandatory email_verified
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "aicodtznation@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Pillar 2: Validation Blueprints
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.role in ['customer', 'vendor', 'rider', 'admin'];
    }

    function isValidVendor(data) {
      return data.businessName is string && data.businessName.size() <= 100 &&
             data.ownerUid == request.auth.uid;
    }

    function isValidOrder(data) {
      return data.customerId is string &&
             data.vendorId is string &&
             data.status is string;
    }

    function isValidRide(data) {
      return data.customerId is string &&
             data.status in [
               'pending', 'accepted', 'arrived', 'started', 
               'completed', 'cancelled', 'searching', 'arriving', 
               'on_trip', 'driver_arriving', 'driver_arrived', 'ready_for_pickup'
             ];
    }

    function isValidDriver(data) {
      return data.isOnline is bool &&
             data.location is map;
    }

    // -------------------------------------------------------------------------
    // Phase 4: Match Blocks
    // -------------------------------------------------------------------------

    // Users
    match /users/{userId} {
      allow get: if isVerified(); // Allow basic profile fetch for chats/orders
      allow list: if isAdmin();
      allow create: if isVerified() && isValidUser(incoming());
      allow update: if isVerified() && (
        (isOwner(userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'fullName', 'photoURL', 'phoneNumber', 'address', 'role',
            'vehicleType', 'vehicleBrand', 'vehicleModel', 'licensePlate', 'driverType',
            'nidaNumber', 'mobileMoneyNumber', 'city', 'preferredWorkArea', 'availability',
            'updatedAt'
          ])
        )) ||
        isAdmin()
      );
    }

    // Vendors
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isVerified() && isValidVendor(incoming());
      allow update: if isVerified() && (
        (isOwner(existing().ownerUid) && (
          incoming().diff(existing()).affectedKeys().hasAny(['businessName', 'description', 'location', 'logoUrl', 'bannerUrl', 'address', 'deliveryRadius', 'tin', 'operatingHours', 'status', 'rating', 'updatedAt'])
        )) ||
        isAdmin()
      );
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isVerified() && (
        (get(/databases/$(database)/documents/vendors/$(incoming().vendorId)).data.ownerUid == request.auth.uid) ||
        (resource != null && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.ownerUid == request.auth.uid) ||
        isAdmin()
      );
    }

    // Orders
    match /orders/{orderId} {
      allow get: if isVerified() && (
        isAdmin() || 
        resource.data.customerId == request.auth.uid || 
        resource.data.vendorOwnerUid == request.auth.uid ||
        resource.data.riderId == request.auth.uid
      );
      allow list: if isVerified() && (
        isAdmin() || 
        resource.data.customerId == request.auth.uid || 
        resource.data.vendorOwnerUid == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        resource.data.status == 'ready_for_pickup'
      );
      allow create: if isVerified() && isValidOrder(incoming()) && incoming().customerId == request.auth.uid;
      allow update: if isVerified() && (
        isAdmin() ||
        isOwner(existing().customerId) ||
        isOwner(existing().vendorOwnerUid) ||
        isOwner(existing().riderId) ||
        (existing().status == 'ready_for_pickup' && incoming().riderId == request.auth.uid)
      );
    }

    // Rides
    match /rides/{rideId} {
      allow read: if isVerified() && (
        isAdmin() || 
        resource.data.customerId == request.auth.uid || 
        resource.data.driverId == request.auth.uid || 
        resource.data.status == 'pending'
      );
      allow create: if isVerified() && isValidRide(incoming()) && incoming().customerId == request.auth.uid;
      allow update: if isVerified() && (
        isAdmin() ||
        isOwner(existing().customerId) ||
        (existing().status == 'pending' && incoming().driverId == request.auth.uid) ||
        isOwner(existing().driverId)
      );
    }

    // Drivers Presence
    match /drivers/{driverId} {
      allow read: if true;
      allow write: if isVerified() && isOwner(driverId);
    }
    
    match /riders/{riderId} {
      allow read: if true;
      allow write: if isVerified() && isOwner(riderId);
    }

    // Communications
    match /messages/{messageId} {
      allow read: if isVerified() && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
      allow create: if isVerified() && incoming().participants.hasAny([request.auth.uid]);
    }

    // Notifications
    match /notifications/{id} { 
      allow read: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isVerified() && (isAdmin() || incoming().userId == request.auth.uid);
    }

    // Coupons, Reviews, Tables, Staff
    match /coupons/{id} {
      allow read: if isVerified();
      allow write: if isVerified() && (isAdmin() || incoming().vendorOwnerUid == request.auth.uid || (resource != null && resource.data.vendorOwnerUid == request.auth.uid));
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if isVerified() && incoming().userId == request.auth.uid;
      allow update, delete: if isVerified() && (isOwner(existing().userId) || isAdmin());
    }
    match /tables/{id} {
      allow read: if true;
      allow write: if isVerified() && (isAdmin() || incoming().vendorOwnerUid == request.auth.uid || (resource != null && resource.data.vendorOwnerUid == request.auth.uid));
    }
    match /staff/{id} {
      allow read: if isVerified() && (resource.data.vendorOwnerUid == request.auth.uid || isAdmin());
      allow write: if isVerified() && (isAdmin() || incoming().vendorOwnerUid == request.auth.uid || (resource != null && resource.data.vendorOwnerUid == request.auth.uid));
    }
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /payments/{id} {
      allow read: if isVerified() && (resource.data.customerId == request.auth.uid || resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isVerified();
    }
  }
}
