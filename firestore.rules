rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // GLOBAL SAFETY NET
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // HELPERS
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn(); // Relaxed for now as we don't have email verification flow in UI
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "aicodtznation@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Master Gate (Only for single doc or write operations)
    function isVendorOwner(vendorId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/vendors/$(vendorId)) && 
             get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerUid == request.auth.uid;
    }

    // ===============================================================
    // ENTITIES
    // ===============================================================

    match /test/connection {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && incoming().role in ['customer', 'vendor', 'rider', 'admin'];
      allow update: if (isOwner(userId) || isAdmin()) && 
                    incoming().role == existing().role &&
                    incoming().diff(existing()).affectedKeys().hasAny(['displayName', 'photoURL', 'phoneNumber', 'address', 'updatedAt', 'status', 'approvalStatus', 'businessName', 'category', 'phone']);
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isVerified() && incoming().ownerUid == request.auth.uid;
      allow update: if (isOwner(existing().ownerUid) || isAdmin()) && 
                    incoming().ownerUid == existing().ownerUid &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['businessName', 'description', 'tin', 'address', 'location', 'deliveryRadius', 'logoUrl', 'bannerUrl', 'phoneNumber', 'operatingHours', 'updatedAt', 'rating']);
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isVerified() && (isVendorOwner(incoming().vendorId) || isVendorOwner(existing().vendorId) || isAdmin());
    }

    match /orders/{orderId} {
      // PILLAR 8: SECURE LIST QUERY
      // We rely on denormalized vendorOwnerUid for vendor listing
      allow list: if isSignedIn() && (
        isAdmin() || 
        resource.data.customerId == request.auth.uid || 
        resource.data.vendorOwnerUid == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        resource.data.status == 'ready_for_pickup'
      );
      
      // PILLAR 1 & 3: SINGLE GET
      allow get: if isSignedIn() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        isVendorOwner(resource.data.vendorId) ||
        resource.data.status == 'ready_for_pickup'
      );

      allow create: if isVerified() && (
        incoming().customerId == request.auth.uid || 
        isVendorOwner(incoming().vendorId)
      );

      allow update: if isVerified() && (
        isAdmin() ||
        (isVendorOwner(existing().vendorId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'riderId', 'updatedAt', 'paymentStatus'])) ||
        (existing().customerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'paymentStatus'])) ||
        (existing().riderId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'paymentStatus', 'location']))
      );

      allow delete: if isAdmin() || (isVerified() && isVendorOwner(existing().vendorId));
    }

    match /tables/{tableId} {
      allow read: if true;
      allow write: if isVerified() && (isVendorOwner(incoming().vendorId) || isVendorOwner(existing().vendorId) || isAdmin());
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isVerified() && (isVendorOwner(incoming().vendorId) || isVendorOwner(existing().vendorId) || isAdmin());
    }

    match /riders/{riderId} {
      allow read: if isSignedIn();
      allow create: if isOwner(riderId);
      allow update: if isOwner(riderId) || isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid && request.auth.uid in incoming().participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['reactions']);
      allow delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow list: if isSignedIn(); // Filtered by query in code
      allow get: if isSignedIn() && (isAdmin() || isVendorOwner(resource.data.vendorId));
      allow create: if isSignedIn() && (isAdmin() || isVendorOwner(incoming().vendorId));
      allow update: if isSignedIn() && (isAdmin() || isVendorOwner(existing().vendorId));
      allow delete: if isSignedIn() && (isAdmin() || isVendorOwner(existing().vendorId));
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isOwner(resource.data.userId) && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isVerified() && incoming().userId == request.auth.uid;
      allow update: if isVerified() && (
        isOwner(existing().userId) || 
        incoming().diff(existing()).affectedKeys().hasOnly(['likes'])
      );
      allow delete: if isOwner(existing().userId) || isAdmin();

      match /replies/{replyId} {
        allow read: if true;
        allow create: if isVerified();
        allow update: if isOwner(existing().userId);
        allow delete: if isOwner(existing().userId) || isAdmin();
      }
    }
  }
}
