rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Phase 3: Primitives & Global Helpers (Hardened)
    // -------------------------------------------------------------------------
    
    function isSignedIn() { return request.auth != null; }
    
    // Relaxed verification for better compatibility
    function isVerified() { return isSignedIn(); }

    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Improved Admin check
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "aicodtznation@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Pillar 3: Path Variable & ID Hardening
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Default Deny (Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Pillar 2: Validation Blueprints (EntityType isValid Helpers)
    // Added size checks for all strings (Pillar 5)
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['customer', 'vendor', 'rider', 'admin'] &&
             data.createdAt == request.time;
    }

    function isValidVendor(data) {
      return data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 100 &&
             data.ownerUid == request.auth.uid &&
             data.status in ['pending', 'active', 'suspended'];
    }

    function isValidOrder(data) {
      return data.customerId is string && data.customerId.size() <= 128 &&
             data.vendorId is string && data.vendorId.size() <= 128 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['pending', 'confirmed', 'preparing', 'ready_for_pickup', 'on_the_way', 'delivered', 'cancelled'];
    }

    function isValidRide(data) {
      return data.customerId is string &&
             data.status in ['pending', 'searching', 'accepted', 'driver_arriving', 'on_trip', 'completed', 'rated', 'cancelled'] &&
             (!('driverId' in data) || data.driverId == null || data.driverId is string) &&
             (!('updatedAt' in data) || data.updatedAt == request.time);
    }

    function isValidDriver(data) {
      return data.isOnline is bool &&
             data.status in ['online', 'offline'] &&
             data.receiving is bool &&
             data.vehicleType is string && data.vehicleType.size() <= 50 &&
             data.location is map;
    }

    // -------------------------------------------------------------------------
    // Phase 4: Match Blocks
    // -------------------------------------------------------------------------

    // Users (Split PII Isolation implicit via owner/admin check)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isVerified() && isValidUser(incoming());
      allow update: if isVerified() && (
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phone', 'address', 'vehicleType', 'vehicleBrand', 'vehicleModel', 'licensePlate', 'driverType'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Vendors
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isVerified() && isValidVendor(incoming());
      allow update: if isVerified() && (
        (isOwner(existing().ownerUid) && incoming().diff(existing()).affectedKeys().hasOnly(['businessName', 'description', 'location', 'logoUrl', 'bannerUrl', 'address', 'deliveryRadius', 'tin', 'operatingHours'])) ||
        isAdmin()
      );
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow create: if isVerified() && get(/databases/$(database)/documents/vendors/$(incoming().vendorId)).data.ownerUid == request.auth.uid;
      allow update: if isVerified() && (
        (get(/databases/$(database)/documents/vendors/$(existing().vendorId)).data.ownerUid == request.auth.uid && 
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'price', 'imageUrl', 'imageUrls', 'category', 'status', 'variations', 'addOns', 'medicationType', 'expiryDate', 'stockQuantity'])) ||
        isAdmin()
      );
      allow delete: if isVerified() && (isAdmin() || get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.ownerUid == request.auth.uid);
    }

    // Orders (Pillar 8: Secure List Queries)
    match /orders/{orderId} {
      allow get: if isVerified() && (
        isAdmin() || 
        resource.data.customerId == request.auth.uid || 
        resource.data.vendorOwnerUid == request.auth.uid ||
        resource.data.riderId == request.auth.uid
      );
      allow list: if isVerified() && (
        isAdmin() || 
        resource.data.customerId == request.auth.uid || 
        resource.data.vendorOwnerUid == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        resource.data.status == 'ready_for_pickup'
      );
      allow create: if isVerified() && isValidOrder(incoming()) && incoming().customerId == request.auth.uid;
      allow update: if isVerified() && (
        isAdmin() ||
        // Customer cancel
        (isOwner(existing().customerId) && incoming().status == 'cancelled' && existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        // Vendor workflow
        (isOwner(existing().vendorOwnerUid) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'riderId', 'paymentStatus'])) ||
        // Rider accept
        (existing().status == 'ready_for_pickup' && incoming().riderId == request.auth.uid && incoming().status == 'on_the_way' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'riderId', 'updatedAt'])) ||
        // Rider complete
        (isOwner(existing().riderId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'paymentStatus']))
      );
    }

    // Rides (Taxi)
    match /rides/{rideId} {
      allow read: if isVerified() && (
        isAdmin() || 
        resource.data.customerId == request.auth.uid || 
        resource.data.driverId == request.auth.uid || 
        resource.data.status == 'pending'
      );
      allow create: if isVerified() && isValidRide(incoming()) && incoming().customerId == request.auth.uid && incoming().createdAt == request.time;
      allow update: if isVerified() && isValidRide(incoming()) && (
        isAdmin() ||
        // Customer rating/cancel/matchmaking simulation
        (isOwner(existing().customerId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'rating', 'review', 'driverId', 'driverInfo', 'driverLocation', 'acceptedAt']) ||
          (existing().status == 'completed' && incoming().status == 'rated' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'rating', 'review']))
        )) ||
        // Driver accept
        (existing().status == 'pending' && incoming().driverId == request.auth.uid && incoming().status == 'driver_arriving' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'driverId', 'updatedAt', 'driverInfo', 'acceptedAt'])) ||
        // Driver update (location/status/eta)
        (isOwner(existing().driverId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'driverLocation', 'eta', 'completedAt']) &&
          // Fare protection: ensure fare doesn't change after on_trip
          (existing().status != 'on_trip' || incoming().fare == existing().fare)
        ))
      );
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isVerified() && (resource.data.customerId == request.auth.uid || resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isVerified() && (incoming().driverId == request.auth.uid || isAdmin());
    }

    // Drivers Presence
    match /drivers/{driverId} {
      allow read: if isVerified();
      allow write: if isVerified() && isOwner(driverId) && isValidDriver(incoming());
    }
    match /riders/{riderId} {
      allow read: if isVerified();
      allow write: if isVerified() && isOwner(riderId);
    }

    // Communications
    match /messages/{messageId} {
      allow read: if isVerified() && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
      allow create: if isVerified() && incoming().participants.hasAny([request.auth.uid]);
      
      match /chats/{chatId} {
        allow read: if isVerified() && (get(/databases/$(database)/documents/messages/$(messageId)).data.participants.hasAny([request.auth.uid]) || isAdmin());
        allow create: if isVerified() && get(/databases/$(database)/documents/messages/$(messageId)).data.participants.hasAny([request.auth.uid]);
      }
    }

    // Supporting Features
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /notifications/{id} { 
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && (isAdmin() || incoming().userId == request.auth.uid);
      allow update: if isVerified() && (isOwner(existing().userId) || isAdmin());
    }
    match /coupons/{id} { allow read: if isVerified(); allow write: if isAdmin(); }
    match /reviews/{id} {
      allow read: if true;
      allow create: if isVerified() && incoming().userId == request.auth.uid;
      allow update, delete: if isVerified() && (isOwner(existing().userId) || isAdmin());
    }
    match /tables/{id} {
      allow read: if true;
      allow write: if isVerified() && (get(/databases/$(database)/documents/vendors/$(incoming().vendorId)).data.ownerUid == request.auth.uid || isAdmin());
    }
    match /staff/{id} {
      allow read: if isVerified() && (resource.data.vendorOwnerUid == request.auth.uid || isAdmin());
      allow write: if isVerified() && (incoming().vendorOwnerUid == request.auth.uid || isAdmin());
    }
  }
}
