rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // PHASE 1: REUSABLE HELPERS
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aicodtznation@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // -------------------------------------------------------------------------
    // PHASE 2: COLLECTION RULES
    // -------------------------------------------------------------------------

    // 1. USERS COLLECTION
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'uid', 'createdAt'])
      );
    }

    // 2. VENDORS COLLECTION
    match /vendors/{vendorId} {
      allow read: if true; // Public access to browse stores
      allow create: if isSignedIn(); // Any signed-in user can become a vendor
      allow update: if isOwner(existing().ownerUid) || isAdmin();
      allow delete: if isOwner(existing().ownerUid) || isAdmin();

      match /sections/{sectionId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // 3. STAFF COLLECTION
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow create: if isOwner(incoming().vendorOwnerUid) || isAdmin();
      allow update: if isOwner(existing().vendorOwnerUid) || isOwner(existing().uid) || (isSignedIn() && incoming().uid == request.auth.uid && incoming().phone == existing().phone && incoming().password == existing().password) || isAdmin();
      allow delete: if isOwner(existing().vendorOwnerUid) || isAdmin();
    }

    // 4. RIDES COLLECTION
    match /rides/{rideId} {
      allow read: if true; // Publicly readable so friends/relatives can track the trip
      allow create: if isSignedIn();
      allow update: if true; // Allow status, position, and viewer count updates
    }

    // 5. ORDERS COLLECTION
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // 6. PRODUCTS COLLECTION
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(get(/databases/$(database)/documents/vendors/$(existing().vendorId)).data.ownerUid) || isAdmin();
    }

    // 7. DRIVERS COLLECTION
    match /drivers/{driverId} {
      allow read: if true;
      allow write: if isOwner(driverId) || isAdmin();
    }

    // 8. NOTIFICATIONS
    match /notifications/{notifId} {
      allow read: if isOwner(existing().userId) || isAdmin();
      allow create: if isSignedIn();
    }

    // 9. MESSAGES
    match /messages/{msgId} {
      allow read: if isSignedIn() && request.auth.uid in existing().participants;
      allow create: if isSignedIn() && request.auth.uid in incoming().participants;
      allow update: if isSignedIn() && request.auth.uid in existing().participants;
    }

    // 10. DRIVER POIS / LOCAL SERVICES
    match /pois/{poiId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        (resource != null && existing().submittedBy == request.auth.uid) ||
        isAdmin()
      );
    }

    // 11. TABLES
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 12. BRANCHES
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 13. REVIEWS
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // 14. REVIEW REPLIES
    match /review_replies/{replyId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 15. BANNERS
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 16. COUPONS
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 17. PAYOUTS
    match /payouts/{payoutId} {
      allow read, write: if isSignedIn();
    }

    // 18. PAYMENTS
    match /payments/{paymentId} {
      allow read, write: if isSignedIn();
    }

    // 19. PARCELS
    match /parcels/{parcelId} {
      allow read: if isSignedIn() && (
        existing().status == 'pending' ||
        existing().customerId == request.auth.uid ||
        existing().partnerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // 20. PARTNERS
    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isOwner(partnerId) || isAdmin();
    }

    // 21. CONFIG
    match /config/business {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 22. BUS SEAT BOOKINGS
    match /bus_seat_bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // 23. META CHATS & SESSIONS
    match /meta_chats/{chatId} {
      allow read, write: if true;
    }
    match /meta_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /sms_chats/{chatId} {
      allow read, write: if true;
    }

    // Default deny for safety
    match /{document=**} {
      allow read, write: if isSignedIn() && isAdmin();
    }
  }
}
