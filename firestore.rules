rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // PHASE 1: REUSABLE HELPERS
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aicodtznation@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // -------------------------------------------------------------------------
    // PHASE 2: COLLECTION RULES
    // -------------------------------------------------------------------------

    // 1. USERS COLLECTION
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 2. VENDORS COLLECTION
    match /vendors/{vendorId} {
      allow read: if true; // Public access to browse stores
      allow create, update, delete: if true;

      match /sections/{sectionId} {
        allow read, write: if true;
      }
    }

    // 3. STAFF COLLECTION
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // 4. RIDES COLLECTION
    match /rides/{rideId} {
      allow read, write: if true;
    }

    // 5. ORDERS COLLECTION
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 6. PRODUCTS COLLECTION
    match /products/{productId} {
      allow read, write: if true;
    }

    // 7. DRIVERS COLLECTION
    match /drivers/{driverId} {
      allow read, write: if true;
    }

    // 8. NOTIFICATIONS
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // 9. MESSAGES
    match /messages/{msgId} {
      allow read, write: if true;
    }

    // 10. DRIVER POIS / LOCAL SERVICES
    match /pois/{poiId} {
      allow read, write: if true;
    }

    // 10b. MASTER GEOCODING PLACES
    match /places/{placeId} {
      allow read, write: if true;
    }

    // 11. TABLES
    match /tables/{tableId} {
      allow read, write: if true;
    }

    // 12. BRANCHES
    match /branches/{branchId} {
      allow read, write: if true;
    }

    // 13. REVIEWS
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // 14. REVIEW REPLIES
    match /review_replies/{replyId} {
      allow read, write: if true;
    }

    // 15. BANNERS
    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // 16. COUPONS
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // 17. PAYOUTS
    match /payouts/{payoutId} {
      allow read, write: if true;
    }

    // 18. PAYMENTS
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // 19. PARCELS
    match /parcels/{parcelId} {
      allow read, write: if true;
    }

    // 20. PARTNERS
    match /partners/{partnerId} {
      allow read, write: if true;
    }

    // 21. CONFIG
    match /config/{configId} {
      allow read, write: if true;
    }

    // 22. BUS SEAT BOOKINGS
    match /bus_seat_bookings/{bookingId} {
      allow read, write: if true;
    }

    // 23. META CHATS & SESSIONS
    match /meta_chats/{chatId} {
      allow read, write: if true;
    }
    match /meta_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /sms_chats/{chatId} {
      allow read, write: if true;
    }
    match /sms_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /payment_callbacks/{id} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
    // 24. STAND POOLING ROUTES (PAPOSHARE STENDI)
    match /stand_pooling_routes/{routeId} {
      allow read, write: if true;
    }

    // Default deny for safety
    match /{document=**} {
      allow read, write: if isSignedIn() && isAdmin();
    }
  }
}
