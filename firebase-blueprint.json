{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "vendor", "driver", "admin"] },
        "walletBalance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Business/Store data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerUid": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerUid", "category"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Staff member working for a vendor",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "password": { "type": "string" },
        "vendorId": { "type": "string" },
        "vendorOwnerUid": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["name", "phone", "vendorId"]
    },
    "Ride": {
      "title": "Ride",
      "description": "Taxi/Delivery request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "driverId": { "type": "string" },
        "status": { "type": "string" },
        "pickup": { "type": "object" },
        "destination": { "type": "object" },
        "fare": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Product order from a vendor",
      "type": "object",
      "properties": {
        "vendorId": { "type": "string" },
        "customerId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vendorId", "customerId", "items", "total", "status"]
    },
    "Poi": {
      "title": "Poi",
      "description": "Nearby local driver services like EV charging, mechanic, car wash, parking, or fuel stations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["charging", "mechanic", "wash", "parking", "fuel"] },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "price": { "type": "string" },
        "rating": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved"] },
        "submittedBy": { "type": "string" },
        "paidAmount": { "type": "number" },
        "transactionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type", "lat", "lng", "status"]
    },
    "Place": {
      "title": "Place",
      "description": "Master Geocoding place records for Tanzania",
      "type": "object",
      "properties": {
        "placeId": { "type": "string" },
        "region": { "type": "string" },
        "district": { "type": "string" },
        "ward": { "type": "string" },
        "streetOrVillage": { "type": "string" },
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "aliases": { "type": "array" },
        "popularNames": { "type": "array" },
        "searchKeywords": { "type": "array" },
        "category": { "type": "string" }
      },
      "required": ["placeId", "region", "district", "ward", "streetOrVillage", "name", "displayName", "latitude", "longitude", "aliases", "popularNames", "searchKeywords"]
    }
  },
  "firestore": {
    "/pois/{poiId}": {
      "schema": "Poi",
      "description": "POI locations and local partner driver services"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles"
    },
    "/vendors/{vendorId}": {
      "schema": "Vendor",
      "description": "Business profiles"
    },
    "/staff/{staffId}": {
      "schema": "Staff",
      "description": "Staff member records"
    },
    "/rides/{rideId}": {
      "schema": "Ride",
      "description": "Ride hailing and delivery records"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store purchase orders"
    },
    "/places/{placeId}": {
      "schema": "Place",
      "description": "Master geocoding place records"
    }
  }
}
