{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "vendor", "driver", "admin"] },
        "walletBalance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Business/Store data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerUid": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerUid", "category"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Staff member working for a vendor",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "password": { "type": "string" },
        "vendorId": { "type": "string" },
        "vendorOwnerUid": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["name", "phone", "vendorId"]
    },
    "Ride": {
      "title": "Ride",
      "description": "Taxi/Delivery request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "driverId": { "type": "string" },
        "status": { "type": "string" },
        "pickup": { "type": "object" },
        "destination": { "type": "object" },
        "fare": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Product order from a vendor",
      "type": "object",
      "properties": {
        "vendorId": { "type": "string" },
        "customerId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vendorId", "customerId", "items", "total", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles"
    },
    "/vendors/{vendorId}": {
      "schema": "Vendor",
      "description": "Business profiles"
    },
    "/staff/{staffId}": {
      "schema": "Staff",
      "description": "Staff member records"
    },
    "/rides/{rideId}": {
      "schema": "Ride",
      "description": "Ride hailing and delivery records"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store purchase orders"
    }
  }
}
