# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# APP_PUBLIC_URL: Public domain used in WhatsApp/Instagram live trip tracking links (/track/:rideId)
APP_PUBLIC_URL=https://dereva-tz.onrender.com
MONGIKE_API_KEY=

# DISABLE_AUTH_BRIDGE: Set to "true" to disable the secure AI Studio Auth Bridge.
# Required for external webhooks (like Meta, Facebook Messenger, Instagram, Twilio) to verify and reach your backend.
DISABLE_AUTH_BRIDGE=

# META_VERIFY_TOKEN: The verify token used by Meta (WhatsApp, Messenger, Instagram) Webhooks.
# Defaults to "papo_hapo_meta_secure_token_2026" if left empty.
META_VERIFY_TOKEN=papo_hapo_meta_secure_token_2026

# META_WHATSAPP_ACCESS_TOKEN: Permanent access token generated in Meta WhatsApp Cloud API setup.
# META_WHATSAPP_PHONE_NUMBER_ID: Phone Number ID for the registered WhatsApp Business number (optional if received in webhook metadata).
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCESS_TOKEN=

# Africa's Talking Two-Way SMS / USSD (Tanzania Local Shortcode)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Cloudinary Configuration for free storage and image/file uploads
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
