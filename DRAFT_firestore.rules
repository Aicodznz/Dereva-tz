rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Phase 3: Primitives & Global Helpers
    // -------------------------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      // Mandating email_verified as per Pillar 5
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "aicodtznation@gmail.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Pillar 2: Validation Blueprints (EntityType isValid Helpers)
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ['customer', 'vendor', 'rider', 'admin'] &&
             data.createdAt == request.time;
    }

    function isValidVendor(data) {
      return data.businessName is string && data.businessName.size() <= 100 &&
             data.ownerUid == request.auth.uid &&
             data.status in ['pending', 'active', 'suspended'];
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.vendorId is string;
    }

    function isValidOrder(data) {
      return data.customerId is string &&
             data.vendorId is string &&
             data.totalAmount is number &&
             data.status in ['pending', 'confirmed', 'preparing', 'ready_for_pickup', 'on_the_way', 'delivered', 'cancelled'];
    }

    function isValidRide(data) {
      return data.customerId is string &&
             data.pickup is map &&
             data.destination is map &&
             data.status in ['pending', 'searching', 'accepted', 'arriving', 'on_trip', 'completed', 'cancelled'];
    }

    function isValidDriver(data) {
      return data.isOnline is bool &&
             data.vehicleType is string &&
             data.location is map;
    }

    // -------------------------------------------------------------------------
    // Phase 4: Fortress Rules
    // -------------------------------------------------------------------------

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isVerified() && isValidUser(incoming());
      allow update: if isVerified() && (
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phone', 'address', 'vehicleType', 'vehicleBrand', 'vehicleModel', 'licensePlate', 'driverType'])) ||
        isAdmin()
      );
    }

    // Vendors
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isVerified() && isValidVendor(incoming());
      allow update: if isVerified() && (
        (isOwner(existing().ownerUid) && incoming().diff(existing()).affectedKeys().hasOnly(['businessName', 'description', 'location', 'logoUrl', 'bannerUrl', 'address', 'deliveryRadius', 'tin', 'operatingHours'])) ||
        isAdmin()
      );
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow create: if isVerified() && isValidProduct(incoming()) && 
                    get(/databases/$(database)/documents/vendors/$(incoming().vendorId)).data.ownerUid == request.auth.uid;
      allow update: if isVerified() && (
        (get(/databases/$(database)/documents/vendors/$(existing().vendorId)).data.ownerUid == request.auth.uid && 
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'price', 'imageUrl', 'imageUrls', 'category', 'status', 'variations', 'addOns', 'medicationType', 'expiryDate'])) ||
        isAdmin()
      );
      allow delete: if isVerified() && (
        get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.ownerUid == request.auth.uid || 
        isAdmin()
      );
    }

    // Orders
    match /orders/{orderId} {
      allow get: if isVerified() && (
        isAdmin() || 
        resource.data.customerId == request.auth.uid || 
        resource.data.vendorOwnerUid == request.auth.uid ||
        resource.data.riderId == request.auth.uid
      );
      allow list: if isVerified() && (
        isAdmin() || 
        resource.data.customerId == request.auth.uid || 
        resource.data.vendorOwnerUid == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        resource.data.status == 'ready_for_pickup'
      );
      allow create: if isVerified() && isValidOrder(incoming()) && incoming().customerId == request.auth.uid;
      allow update: if isVerified() && (
        isAdmin() ||
        // Customer cancelling
        (isOwner(existing().customerId) && incoming().status == 'cancelled' && existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        // Vendor managing
        (isOwner(existing().vendorOwnerUid) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'riderId'])) ||
        // Rider accepting
        (existing().status == 'ready_for_pickup' && incoming().riderId == request.auth.uid && incoming().status == 'on_the_way' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'riderId', 'updatedAt'])) ||
        // Rider completing
        (isOwner(existing().riderId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'paymentStatus']))
      );
    }

    // Rides
    match /rides/{rideId} {
      allow read: if isVerified() && (
        isAdmin() || 
        resource.data.customerId == request.auth.uid || 
        resource.data.driverId == request.auth.uid || 
        resource.data.status == 'pending'
      );
      allow create: if isVerified() && isValidRide(incoming()) && incoming().customerId == request.auth.uid;
      allow update: if isVerified() && (
        isAdmin() ||
        // Customer actions
        (isOwner(existing().customerId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'rating'])) ||
        // Driver accepting
        (existing().status == 'pending' && incoming().driverId == request.auth.uid && incoming().status == 'accepted' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'driverId', 'updatedAt', 'driverLocation', 'driverName', 'driverPhone', 'driverPhoto'])) ||
        // Driver actions
        (isOwner(existing().driverId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'driverLocation']))
      );
    }

    // Drivers & Riders (using both for compatibility)
    match /drivers/{driverId} {
      allow read: if isVerified();
      allow write: if isOwner(driverId);
    }
    match /riders/{riderId} {
      allow read: if isVerified();
      allow write: if isOwner(riderId);
    }

    // Messages
    match /messages/{messageId} {
      allow read: if isVerified() && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
      allow create: if isVerified() && incoming().participants.hasAny([request.auth.uid]);
      
      match /chats/{chatId} {
        allow read: if isVerified() && (get(/databases/$(database)/documents/messages/$(messageId)).data.participants.hasAny([request.auth.uid]) || isAdmin());
        allow create: if isVerified() && get(/databases/$(database)/documents/messages/$(messageId)).data.participants.hasAny([request.auth.uid]);
      }
    }

    // Banners, Notifications, Coupons, Reviews
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /notifications/{id} { 
      allow read: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin() || (isVerified() && incoming().userId == request.auth.uid); 
    }
    match /coupons/{id} { allow read: if isVerified(); allow write: if isAdmin(); }
    
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isVerified() && incoming().userId == request.auth.uid;
      allow update: if isVerified() && (isOwner(existing().userId) || isAdmin());
      allow delete: if isVerified() && (isOwner(existing().userId) || isAdmin());
      
      match /replies/{replyId} {
        allow read: if true;
        allow create: if isVerified(); // Anyone verified can reply for now, or restrict to vendor/original user if needed
        allow delete: if isVerified() && (isOwner(resource.data.userId) || isAdmin());
      }
    }
  }
}
